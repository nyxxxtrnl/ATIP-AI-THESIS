# Optional secret for trusted robot/result ingestion:
# set ATIP_INGEST_API_KEY to a long random value before using /api/ingest/results

# Optional data folder; defaults to .data beside server.mjs
# ATIP_DATA_DIR=C:\ATIP-private-data

# Set to true only when serving through HTTPS:
# ATIP_SECURE_COOKIE=true

# OAuth public URL and provider credentials:
# ATIP_PUBLIC_URL=https://atip-ai-thesis-demo.onrender.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

PORT=3000
